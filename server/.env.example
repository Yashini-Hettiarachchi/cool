# Server
PORT=3000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=ac_service_system

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# First admin (used by db/seed-admin.js)
SEED_ADMIN_NAME=Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PHONE=0770000000
SEED_ADMIN_PASSWORD=admin123

# SMS (Text.lk)
# SMS_ENABLED=false keeps the system in log-only mode: messages are rendered and
# recorded in sms_logs with status 'logged', but nothing is delivered. Flip to
# true once the API key and an approved sender ID are in place, then prove it
# with SMS Centre → Send a test message before relying on it.
SMS_ENABLED=false
TEXTLK_API_KEY=
TEXTLK_SENDER_ID=
# How long to wait on Text.lk before giving up on a single message (ms).
SMS_TIMEOUT_MS=15000

# Business timezone — used to work out "tomorrow" for the reminder cron.
# Leave as-is unless the company moves country.
BUSINESS_TZ=Asia/Colombo

# Frontend origin for CORS in dev (Vite)
CLIENT_ORIGIN=http://localhost:5173
