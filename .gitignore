# Dependencies
node_modules/
client/node_modules/
server/node_modules/

# Env / secrets
# server/.env is deliberately tracked: this is a private repo and the deployment
# is a single client install, so keeping the working config in-repo is simpler
# than re-entering it per environment. It holds live credentials (DB, JWT,
# Text.lk) — anyone with repo access has them, so rotate on access changes.
.env
.env.*
!.env.example
!server/.env
client/.env

# Build output
client/dist/
client/build/

# Uploads (technician photos — not committed)
server/uploads/job_photos/*
!server/uploads/job_photos/.gitkeep

# Logs
*.log
npm-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Project docs (design plans, phase plans, wireframes) — local only

